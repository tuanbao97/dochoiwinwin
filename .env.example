APP_NAME="Do Choi Win Win"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Đăng nhập mạng xã hội — dùng OAuth Client, KHÔNG dùng Gemini API key
# Callback phải được khai báo giống hệt trong Google Cloud Console / Meta for Developers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_APP_ID=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# Sapo Private App (Basic Auth) — BẮT BUỘC trên production để nút Fetch Sapo hoạt động
# Auth: https://{{SAPO_API_KEY}}:{{SAPO_API_SECRET}}@{{SAPO_STORE}}/admin/...
# Sau khi sửa .env trên server: php artisan optimize:clear
# Kiểm tra: php artisan sapo:status --ping
SAPO_ENABLED=true
SAPO_STORE=thegioisuawinwin.mysapo.net
SAPO_API_KEY=
SAPO_API_SECRET=
SAPO_ACCESS_TOKEN=
SAPO_TIMEOUT=60
SAPO_PRODUCT_TYPE="Đồ chơi"
SAPO_SYNC_MIN_INTERVAL=60
SAPO_STOREFRONT_SOURCE=local
